        }
      ]
    },
    {
      "title": "Depth Imbalance (bps=${bps})",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "repeat": "bps",
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "from(bucket: \"market_data\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r[\"_measurement\"] == \"DEPTH_IMBALANCE\") |> filter(fn: (r) => r[\"exchange_name\"] == \"${exchange}\") |> filter(fn: (r) => r[\"symbol\"] == \"${symbol}\") |> filter(fn: (r) => r[\"bps\"] == \"${bps}\") |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false) |> yield(name: \"mean\")"
        }
      ]
    },
    {
      "title": "Microprice (k=${k})",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "repeat": "k",
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "from(bucket: \"market_data\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r[\"_measurement\"] == \"MICROPRICE\") |> filter(fn: (r) => r[\"exchange_name\"] == \"${exchange}\") |> filter(fn: (r) => r[\"symbol\"] == \"${symbol}\") |> filter(fn: (r) => r[\"k\"] == \"${k}\") |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false) |> yield(name: \"mean\")"
        }
      ]
    }
  ],
  "refresh": "5s",
