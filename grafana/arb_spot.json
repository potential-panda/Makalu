    {
      "title": "Arb opportunity % — GMO/BITBANK",
      "description": "% of 1s windows where a true cross-exchange arb exists (before fees).",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 27 },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "import \"contrib/tomhollingworth/events\"\nfrom(bucket: \"makalu_ArbSpot\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r[\"_measurement\"] == \"ArbSpot\") |> filter(fn: (r) => r[\"exchange_a\"] == \"GMO\" and r[\"exchange_b\"] == \"BITBANK\") |> filter(fn: (r) => r[\"symbol\"] == \"${symbol}\") |> filter(fn: (r) => r[\"_field\"] == \"arb_ab_bps\" or r[\"_field\"] == \"arb_ba_bps\") |> map(fn: (r) => ({r with _value: if r._value > 0.0 then 1.0 else 0.0})) |> mean() |> map(fn: (r) => ({r with _value: r._value * 100.0}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["mean"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" }
    },
