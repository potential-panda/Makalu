  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true, "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts", "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Cross-exchange mid spread — GMO vs BITBANK (bps)",
      "description": "Positive = GMO costlier. Green fill = buy BITBANK/sell GMO arb. Red = buy GMO/sell BITBANK arb.",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "from(bucket: \"makalu_ArbSpot\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r[\"_measurement\"] == \"ArbSpot\") |> filter(fn: (r) => r[\"exchange_a\"] == \"GMO\" and r[\"exchange_b\"] == \"BITBANK\") |> filter(fn: (r) => r[\"symbol\"] == \"${symbol}\") |> filter(fn: (r) => r[\"_field\"] == \"cross_bps\" or r[\"_field\"] == \"arb_ab_bps\" or r[\"_field\"] == \"arb_ba_bps\") |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false) |> yield(name: \"mean\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8,
            "gradientMode": "none", "spanNulls": false,
            "showPoints": "never", "lineInterpolation": "linear",
            "axisCenteredZero": true
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "cross_bps" },
            "properties": [
              { "id": "displayName", "value": "mid spread (bps)" },
              { "id": "color", "value": { "fixedColor": "#4a90d9", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "arb_ab_bps" },
            "properties": [
              { "id": "displayName", "value": "buy BITBANK / sell GMO (bps)" },
              { "id": "color", "value": { "fixedColor": "#27ae60", "mode": "fixed" } },
              { "id": "custom.fillOpacity", "value": 20 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "arb_ba_bps" },
            "properties": [
              { "id": "displayName", "value": "buy GMO / sell BITBANK (bps)" },
              { "id": "color", "value": { "fixedColor": "#e74c3c", "mode": "fixed" } },
              { "id": "custom.fillOpacity", "value": 20 }
            ]
          }
        ]
      }
    },
